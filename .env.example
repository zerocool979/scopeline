# Salin menjadi .env (opsional). Semua nilai punya default aman untuk pengembangan.
SECRET_KEY=            # kosong = dibuat otomatis & disimpan di volume /data
ADMIN_USERNAME=admin
ADMIN_PASSWORD=        # kosong = acak, dicetak sekali di log
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-kuat
BIND_ADDR=127.0.0.1    # gunakan reverse proxy TLS (mis. Caddy/Nginx + Let's Encrypt) di depan aplikasi
PORT=8000
